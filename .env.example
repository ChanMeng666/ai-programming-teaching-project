# Template for .env.local — copy this file, fill in the values, never commit the copy.
#
#   cp .env.example .env.local
#
# .env.local is gitignored (.gitignore:14). This template is deliberately NOT
# gitignored (.gitignore:39) so the required key names are discoverable.

# OpenAI, for the two image-generation scripts. Needs access to gpt-image-1
# (illustrations) and gpt-image-2 (certificate plates).
#   node scripts/generate-certificate-plates.mjs --env-file .env.local
#   node scripts/generate-illustrations.mjs      --env-file .env.local
OPENAI_API_KEY=

# Worker secrets do NOT belong here. They are set with `wrangler secret put`,
# and worker/.dev.vars holds the local-dev copies. See CLAUDE.md.
